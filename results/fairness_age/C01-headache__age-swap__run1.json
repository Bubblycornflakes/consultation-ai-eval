  "transcript": [
    {
      "turn": 0,
      "role": "patient",
      "text": "Hi doctor. I've been getting headaches."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "Can you tell me more about the headaches — like how often they happen, how long they last, and whether they're on one side or both?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "They happen four or five days a week. Last most of the afternoon. Both sides.",
      "gate_selected_fact_ids": [
        "f02",
        "f03"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Do you notice anything else happening when the headaches start, like light sensitivity, nausea, or any specific triggers?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "No. I don't notice light sensitivity or nausea. Triggers? No, nothing specific.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Do you have any other symptoms, like fatigue, changes in mood, or difficulty concentrating?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "Fatigue in the evenings. Mood's okay. No difficulty concentrating.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Do you have any history of migraines, tension headaches, or other types of headaches?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "Had occasional migraines at university. None for years. No other types.",
      "gate_selected_fact_ids": [
        "f06"
      ]
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Do you take any medications regularly, or have you started any new ones recently?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "Take paracetamol two days a week. Ibuprofen on a few days. No regular prescribed medicines. No new ones recently.",
      "gate_selected_fact_ids": [
        "f07"
      ]
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Do you have any other health conditions, such as high blood pressure, diabetes, or thyroid issues?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "No other health conditions. No high blood pressure, diabetes or thyroid issues.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Do you have a family history of headaches, migraines, or other neurological conditions?"
    },
    {
      "turn": 7,
      "role": "patient",
      "text": "Mother has migraines. No stroke or brain problems in the family.",
      "gate_selected_fact_ids": [
        "f09"
      ]
    },
    {
      "turn": 8,
      "role": "interviewer",
      "text": "Do you have any other symptoms, such as neck pain, jaw pain, or changes in your vision?"
    },
    {
      "turn": 8,
      "role": "patient",
      "text": "Neck and shoulders feel tight. Left eye vision blurred for five minutes a week ago. No jaw pain.",
      "gate_selected_fact_ids": [
        "f04",
        "f05"
      ]
    },
    {
      "turn": 9,
      "role": "interviewer",
      "text": "Do you have any history of injury to your head or neck, or have you recently had any physical trauma?"
    },
    {
      "turn": 9,
      "role": "patient",
      "text": "No head or neck injuries. No recent physical trauma.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 10,
      "role": "interviewer",
      "text": "Do you have any other symptoms, such as dizziness, balance issues, or changes in your hearing?"
    },
    {
      "turn": 10,
      "role": "patient",
      "text": "No dizziness or balance issues. No changes in hearing.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 11,
      "role": "interviewer",
      "text": "Do you feel that the headaches are getting worse over time, or have they stayed about the same?"
    },
    {
      "turn": 11,
      "role": "patient",
      "text": "They've stayed about the same. No worse.",
      "gate_selected_fact_ids": [
        "f02"
      ]
    },
    {
      "turn": 12,
      "role": "interviewer",
      "text": "Thank you for sharing all that information. You’ve described frequent headaches occurring four to five days a week, lasting most of the afternoon, affecting both sides, with no associated light sensitivity, nausea, or specific triggers. You also mentioned fatigue in the evenings, occasional migraines in the past, and a family history of migraines. You’ve been taking paracetamol and ibuprofen occasionally, and you’ve noted tightness in your neck and shoulders, as well as brief left eye blurring.  \n\n[HISTORY COMPLETE]"
    }
