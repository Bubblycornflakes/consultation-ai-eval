  "transcript": [
    {
      "turn": 0,
      "role": "patient",
      "text": "Um, hi. I just feel really tired all the time."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "How long have you been feeling this way?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "Two months. It's been getting worse slowly.",
      "gate_selected_fact_ids": [
        "f02"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms along with the tiredness, like weight changes, trouble sleeping, or mood changes?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "I've lost about 4 kg in two months. I wake soaked in sweat two or three nights a week. I've been more thirsty than usual and passing urine more often.",
      "gate_selected_fact_ids": [
        "f04",
        "f05",
        "f06",
        "f07"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Have you experienced any changes in your appetite or eating habits recently?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "I haven't noticed much change in my appetite. I still eat regular meals, but I feel full quickly and don't want to eat much after that.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Have you had any recent changes in your energy levels or physical activity?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "I've been less active than usual. I feel too heavy in my arms and legs to move much. I don't have the energy to do things I used to.",
      "gate_selected_fact_ids": [
        "f02",
        "f03"
      ]
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Have you noticed any changes in your skin, such as dryness, itching, or rashes?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "I've had my eczema flare up more than usual. My skin feels dry and itchy, especially on my hands and arms.",
      "gate_selected_fact_ids": [
        "f08"
      ]
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Have you experienced any changes in your menstrual cycle, such as irregular periods, heavier bleeding, or missed periods?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "I haven't had my period for three months. I'm not sure if it's because of the weight loss or something else.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms, such as nausea, vomiting, or abdominal pain?"
    },
    {
      "turn": 7,
      "role": "patient",
      "text": "I've felt a bit nauseous in the mornings, but not enough to vomit. My stomach feels a little tight, but not painful.",
      "gate_selected_fact_ids": [
        "f04",
        "f05",
        "f06",
        "f07"
      ]
    },
    {
      "turn": 8,
      "role": "interviewer",
      "text": "Have you had any recent changes in your bowel habits, such as constipation, diarrhea, or changes in stool consistency?"
    },
    {
      "turn": 8,
      "role": "patient",
      "text": "I've had more constipation than usual. My stools are harder and less frequent.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 9,
      "role": "interviewer",
      "text": "Have you noticed any swelling or discomfort in your abdomen?"
    },
    {
      "turn": 9,
      "role": "patient",
      "text": "I've felt some bloating in my abdomen, but not sure if it's from gas or something else. It doesn't hurt much, but it's there.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 10,
      "role": "interviewer",
      "text": "Have you had any recent changes in your vision, such as blurriness or difficulty seeing at night?"
    },
    {
      "turn": 10,
      "role": "patient",
      "text": "No.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 11,
      "role": "interviewer",
      "text": "Have you experienced any unexplained weight loss, even if you're eating regularly?"
    },
    {
      "turn": 11,
      "role": "patient",
      "text": "I've lost about 4 kg in two months without trying. I still eat regular meals, but I feel full quickly and don't want to eat much after that.",
      "gate_selected_fact_ids": [
        "f06"
      ]
    },
    {
      "turn": 12,
      "role": "interviewer",
      "text": "Have you noticed any changes in your temperature regulation, such as feeling unusually hot or cold?  \n\n[HISTORY COMPLETE]"
    }
