  "transcript": [
    {
      "turn": 0,
      "role": "patient",
      "text": "Hello. I've had this cough for ages and I'm starting to worry about it."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "Can you tell me more about your cough — for example, is it a dry cough or do you have phlegm?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "It's mostly a dry, tickly cough. I've coughed up phlegm with a few streaks of blood twice this week.",
      "gate_selected_fact_ids": [
        "f01",
        "f03",
        "f05"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms, such as chest pain, shortness of breath, or fatigue?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "I've felt a little short of breath climbing two flights of stairs. I haven't noticed any chest pain or fatigue.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Have you been exposed to any irritants, such as smoke, dust, or chemicals, recently?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "I think the cough is left over from the cold and made worse by dust in the van. I haven't been exposed to smoke or chemicals recently.",
      "gate_selected_fact_ids": [
        "f11"
      ]
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Have you had any recent changes in your health, such as weight loss, fever, or night sweats?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "I haven't had any recent changes in my health. No weight loss, fever, or night sweats.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Have you had any recent changes in your environment, such as moving house, changes in work, or new exposures?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "I've been working in a van, which has more dust than usual. I haven't moved house or had any other changes in my environment.",
      "gate_selected_fact_ids": [
        "f11"
      ]
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Have you had any previous lung issues, such as asthma, bronchitis, or pneumonia?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "I had asthma as a child and grew out of it as a teenager. I've never had bronchitis or pneumonia.",
      "gate_selected_fact_ids": [
        "f06"
      ]
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Have you noticed if the cough is worse at certain times of day, or if it seems to be triggered by specific activities?"
    },
    {
      "turn": 7,
      "role": "patient",
      "text": "It's worse at night and first thing in the morning. It seems to be triggered by lying down or waking up.",
      "gate_selected_fact_ids": [
        "f03"
      ]
    },
    {
      "turn": 8,
      "role": "interviewer",
      "text": "Have you been exposed to any pets, animals, or allergens in the van or your home?"
    },
    {
      "turn": 8,
      "role": "patient",
      "text": "I haven't been exposed to any pets or animals recently. I'm not sure about allergens in the van or my home, but I think the dust is the main issue.",
      "gate_selected_fact_ids": [
        "f11"
      ]
    },
    {
      "turn": 9,
      "role": "interviewer",
      "text": "Have you had any recent changes in your diet, stress levels, or sleep patterns?  \n\n[HISTORY COMPLETE]"
    }
  ],
