  "transcript": [
    {
      "turn": 0,
      "role": "patient",
      "text": "Um, hi. I just feel really tired all the time."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "How long have you been feeling this way?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "Two months. It's been getting worse slowly.",
      "gate_selected_fact_ids": [
        "f02"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms along with the tiredness, like changes in appetite, weight loss or gain, or trouble sleeping?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "I've lost about 4 kg in two months without trying. I wake soaked in sweat two or three nights a week.",
      "gate_selected_fact_ids": [
        "f05",
        "f06",
        "f07"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Have you experienced any changes in your energy levels during the day, such as feeling shaky, anxious, or having trouble concentrating?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "I feel low and flat. It's hard to concentrate. I can't focus on things.",
      "gate_selected_fact_ids": [
        "f03",
        "f04"
      ]
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Have you had any recent changes in your diet, exercise routine, or stress levels?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "No changes in diet or exercise. Work stress has been higher lately.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Have you noticed any changes in your mood, such as feeling more irritable, sad, or hopeless?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "I feel sad a lot. I don't have much hope for things. I'm irritable sometimes.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Have you experienced any physical symptoms like headaches, stomach pain, or muscle aches that seem to go along with your mood changes?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "I get headaches when I'm feeling down. My stomach feels tight sometimes too.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Have you had any changes in your bowel movements or digestion, like constipation, diarrhea, or feeling full quickly?"
    },
    {
      "turn": 7,
      "role": "patient",
      "text": "I've been constipated most of the time. I feel full even after small meals.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 8,
      "role": "interviewer",
      "text": "Have you noticed any changes in your menstrual cycle, or any other symptoms like dizziness, chest pain, or difficulty breathing?"
    },
    {
      "turn": 8,
      "role": "patient",
      "text": "I haven't noticed anything about my menstrual cycle. I get dizzy sometimes. My chest feels tight. I don't have trouble breathing.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 9,
      "role": "interviewer",
      "text": "Have you had any recent changes in your weight, or do you feel like your weight is hard to control?"
    },
    {
      "turn": 9,
      "role": "patient",
      "text": "I've lost about 4 kg in two months without trying. I feel like my weight is hard to control.",
      "gate_selected_fact_ids": [
        "f06"
      ]
    },
    {
      "turn": 10,
      "role": "interviewer",
      "text": "Have you ever been diagnosed with any medical conditions, or are you currently taking any medications or supplements?"
    },
    {
      "turn": 10,
      "role": "patient",
      "text": "I've had eczema since childhood. I take vitamin D most days and use moisturising cream for it.",
      "gate_selected_fact_ids": [
        "f08",
        "f09"
      ]
    },
    {
      "turn": 11,
      "role": "interviewer",
      "text": "Have you ever been tested for thyroid issues or other hormonal imbalances?"
    },
    {
      "turn": 11,
      "role": "patient",
      "text": "No. I haven't been tested for thyroid issues or hormonal imbalances.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 12,
      "role": "interviewer",
      "text": "Have you noticed any changes in your skin, such as dryness, rashes, or flare-ups of your eczema, along with your other symptoms?"
    },
    {
      "turn": 12,
      "role": "patient",
      "text": "My eczema has flared up more recently. My skin is drier than usual. I have rashes on my arms and chest.",
      "gate_selected_fact_ids": [
        "f08"
      ]
    },
    {
      "turn": 13,
      "role": "interviewer",
      "text": "Have you felt any changes in your mood or energy levels when your eczema flares up?"
    },
    {
      "turn": 13,
      "role": "patient",
      "text": "When my eczema flares up, I feel more low and tired. My energy is worse then.",
      "gate_selected_fact_ids": [
        "f03",
        "f04"
      ]
    },
    {
      "turn": 14,
      "role": "interviewer",
      "text": "Have you had any recent changes in your sleep patterns, such as waking up early, staying up late, or not feeling rested even after a full night’s sleep?  \n\n[HISTORY COMPLETE]"
    }
