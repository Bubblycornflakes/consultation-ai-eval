  "transcript": [
    {
      "turn": 0,
      "role": "patient",
      "text": "Hello. I've had this cough for ages and I'm starting to worry about it."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "Can you tell me more about your cough — for example, is it a dry cough or do you have any phlegm?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "It's mostly a dry cough, but I've coughed up some phlegm with a few streaks of blood twice this week.",
      "gate_selected_fact_ids": [
        "f01",
        "f03",
        "f05"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms, such as chest pain, shortness of breath, or a fever?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "A little short of breath climbing two flights of stairs. No fever and no chest pain.",
      "gate_selected_fact_ids": [
        "f04"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Have you been exposed to anyone with a cough or cold recently, or have you been in any environments that might irritate your airways, like smoke or dust?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "I think the cough is left over from the cold and made worse by dust in the van.",
      "gate_selected_fact_ids": [
        "f11"
      ]
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Have you had any recent changes in your health, such as weight loss, fatigue, or a change in your appetite?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "I've been feeling more tired than usual, but I haven't lost any weight or changed my appetite.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Have you smoked in the past, and if so, how many cigarettes per day?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "I smoked ten a day for about ten years and stopped five years ago.",
      "gate_selected_fact_ids": [
        "f10"
      ]
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Have you had any recent changes in your environment, such as moving house, changes in work, or exposure to new substances?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "I moved house six months ago, and the new place has a lot of dust. I've also been working longer hours, which probably makes it worse.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms, such as wheezing, dizziness, or a change in your cough over time?"
    },
    {
      "turn": 7,
      "role": "patient",
      "text": "I've had a wheeze a few times, mostly at night. The cough has been getting worse over the last few weeks.",
      "gate_selected_fact_ids": [
        "f03",
        "f04",
        "f05"
      ]
    },
    {
      "turn": 8,
      "role": "interviewer",
      "text": "Have you had any recent illnesses, such as a cold, flu, or bronchitis?"
    },
    {
      "turn": 8,
      "role": "patient",
      "text": "I had a heavy cold five weeks ago, which went away, but the cough stayed. I haven't had flu or bronchitis.",
      "gate_selected_fact_ids": [
        "f02"
      ]
    },
    {
      "turn": 9,
      "role": "interviewer",
      "text": "Have you had any difficulty sleeping due to your cough or wheezing?  \n\nHISTORY COMPLETE"
    },
    {
      "turn": 9,
      "role": "patient",
      "text": "Yes, the cough wakes me up about twice a week, and the wheezing makes it hard to get back to sleep.",
      "gate_selected_fact_ids": [
        "f03"
      ]
    },
    {
      "turn": 10,
      "role": "interviewer",
      "text": "HISTORY COMPLETE"
    },
    {
      "turn": 10,
      "role": "patient",
      "text": "I'm really worried it might be something serious. I just want to make sure I'm not missing anything.",
      "gate_selected_fact_ids": []
    },
    {
