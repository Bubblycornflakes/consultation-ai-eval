    {
      "turn": 0,
      "role": "patient",
      "text": "Um, hi. I just feel really tired all the time."
    },
    {
      "turn": 1,
      "role": "interviewer",
      "text": "How long have you been feeling this way?"
    },
    {
      "turn": 1,
      "role": "patient",
      "text": "Two months. It's been getting worse slowly.",
      "gate_selected_fact_ids": [
        "f02"
      ]
    },
    {
      "turn": 2,
      "role": "interviewer",
      "text": "Have you noticed any other symptoms along with the tiredness, like changes in appetite, weight, mood, or trouble sleeping?"
    },
    {
      "turn": 2,
      "role": "patient",
      "text": "I've lost interest in my hobbies. I've been more thirsty and passing urine more often. I've lost about 4 kg in two months. I wake up sweaty two or three nights a week.",
      "gate_selected_fact_ids": [
        "f04",
        "f05",
        "f06",
        "f07"
      ]
    },
    {
      "turn": 3,
      "role": "interviewer",
      "text": "Have you experienced any changes in your energy levels during the day, such as feeling sluggish or having trouble concentrating?"
    },
    {
      "turn": 3,
      "role": "patient",
      "text": "Yes. My arms and legs feel heavy. I find it hard to concentrate. I rate my energy level 3 out of 10.",
      "gate_selected_fact_ids": [
        "f03",
        "f04"
      ]
    },
    {
      "turn": 4,
      "role": "interviewer",
      "text": "Have you noticed any changes in your skin, such as dryness, rashes, or unusual hair loss?"
    },
    {
      "turn": 4,
      "role": "patient",
      "text": "I've been losing hair from my scalp. My skin feels dry, especially on my hands.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 5,
      "role": "interviewer",
      "text": "Have you had any recent changes in your diet, exercise routine, or stress levels?"
    },
    {
      "turn": 5,
      "role": "patient",
      "text": "I've been eating less. I haven't been exercising. I've been working longer hours, but I don't feel more stressed.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 6,
      "role": "interviewer",
      "text": "Have you had any recent changes in your menstrual cycle, such as irregular periods or heavier/lighter bleeding?"
    },
    {
      "turn": 6,
      "role": "patient",
      "text": "I haven't had my period for two months.",
      "gate_selected_fact_ids": []
    },
    {
      "turn": 7,
      "role": "interviewer",
      "text": "Have you experienced any swelling in your hands, feet, or face recently?"
